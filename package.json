{
  "name": "learn",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "A teacher-operated whole-class lesson player for Mr. Friend.",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "test:practice": "node tests/practice-browser.cjs",
    "test:classroom": "node tests/classroom-browser.cjs",
    "test:plans": "node tests/plans-browser.cjs",
    "test:gp": "node tests/gp-browser.cjs",
    "test:grade7": "node tests/grade7-browser.cjs",
    "test:grade7b": "node tests/grade7b-browser.cjs",
    "test:visuals": "node tests/visuals-browser.cjs",
    "test:pilot": "node tests/pilot-browser.cjs",
    "test:editor": "node tests/lesson-editor-browser.cjs",
    "build:students": "node scripts/build-students.mjs && node scripts/build-student-visuals.cjs",
    "test:students": "node tests/students-browser.cjs",
    "test:students:catalog": "node tests/students-catalog-browser.cjs",
    "audit:student-translations": "node scripts/audit-student-translations.mjs",
    "test:pacing": "node tests/pacing-browser.cjs"
